# 复制为 secrets.env 后填写。不要提交 secrets.env
# 生产建议改用 External Secrets / Sealed Secrets / 云厂商密钥管理，而不是本地文件
DATABASE_URL=postgres://goapi:CHANGE_ME@my-db.example.internal:5432/goapi?sslmode=require
# 可选：多副本共享限流计数。不填则每个 Pod 单独计数
REDIS_URL=
# outbox relay 投递目标，可能带凭据，所以放在 secret 里。生产必填
NATS_URL=
# 必填：分页游标的签名密钥，至少 32 字节，所有副本共用。生成：openssl rand -base64 48
# 轮换时把旧值放进 CURSOR_SECRET_PREVIOUS，新值放进 CURSOR_SECRET，过一两天再删掉旧值
CURSOR_SECRET=
CURSOR_SECRET_PREVIOUS=
