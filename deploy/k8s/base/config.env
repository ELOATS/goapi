# 非敏感配置，进仓库。敏感信息写 secrets.env
APP_ENV=prod
LOG_LEVEL=info
HTTP_ADDR=:8080
METRICS_ADDR=:9090

# 优雅关闭：SHUTDOWN_DRAIN_DELAY + SHUTDOWN_TIMEOUT 必须小于
# Deployment 的 terminationGracePeriodSeconds（40s），留出余量
SHUTDOWN_DRAIN_DELAY=10s
SHUTDOWN_TIMEOUT=20s

# 迁移由 migrate Job 执行，应用启动时不跑
DB_MIGRATE_ON_START=false
DB_MAX_CONNS=10
DB_MIN_CONNS=2

OTEL_SERVICE_NAME=goapi
# 例如集群里的 OpenTelemetry Collector；留空则不导出链路
OTEL_EXPORTER_OTLP_ENDPOINT=
TRACE_SAMPLE_RATIO=0.1

PPROF_ENABLED=false

# 内存软上限，设为容器 memory limit 的约 90%（limit 256Mi → 230MiB）。
# 接近上限时 GC 会更积极，避免被 OOMKill。改 limit 时同步改这里
GOMEMLIMIT=230MiB

# 认证（OIDC）。issuer 必须与身份提供方 discovery 文档里的完全一致，
# 启动时会请求 <issuer>/.well-known/openid-configuration，失败则 Pod 起不来。
# 下面是占位值，部署前必须改成你们的身份提供方。
OIDC_ISSUER_URL=https://idp.example.com/realms/goapi
OIDC_AUDIENCE=goapi
# 角色所在的声明：Keycloak 用 realm_access.roles，Microsoft Entra ID 用 roles，
# Auth0 用 Action 写入的自定义声明（例如 https://goapi.example.com/roles）
OIDC_ROLES_CLAIM=realm_access.roles

# 限流：每个客户端 IP、每个用户各一条规则（长期平均 RPS / 允许的突发数）。
# 多副本共享计数需要在 secrets.env 里配置 REDIS_URL，否则实际限额 = 限额 × 副本数
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_RPS=20
RATE_LIMIT_IP_BURST=40
RATE_LIMIT_USER_RPS=10
RATE_LIMIT_USER_BURST=20
# 写接口（POST）另外按用户限流，比上面的总额度更严
RATE_LIMIT_WRITE_RPS=2
RATE_LIMIT_WRITE_BURST=10

# 在 Envoy Gateway 后面：信任它写入的 X-Envoy-External-Address（Envoy 会先删掉客户端自带的同名头）。
# 不开的话所有请求的来源都是 Envoy Pod 的 IP，会共用同一份 IP 额度。
# 前面还有云负载均衡时，要让 Envoy 拿到真实客户端 IP，见 overlays/*/gateway.yaml 里的 ClientTrafficPolicy
HTTP_TRUST_PROXY=true
HTTP_CLIENT_IP_HEADER=X-Envoy-External-Address

# outbox relay（cmd/relay）
RELAY_BATCH_SIZE=100
RELAY_POLL_INTERVAL=1s
# 数据库前面是 PgBouncer 事务池模式时 LISTEN 不可用，改成 false（只靠轮询，延迟最多 RELAY_POLL_INTERVAL）
RELAY_LISTEN=true
# 已投递事件在数据库里保留多久
OUTBOX_RETENTION=168h
NATS_STREAM=GOAPI_EVENTS
NATS_SUBJECT_PREFIX=goapi.events
# NATS 集群 3 节点时可设为 3
NATS_STREAM_REPLICAS=1
NATS_STREAM_MAX_AGE=168h

# API 文档：/api/openapi.yaml 和 /api/docs（Swagger UI），不需要认证。production overlay 里关闭
DOCS_ENABLED=true

# 示例事件消费者（cmd/consumer）
CONSUMER_NAME=goapi-welcome
CONSUMER_ACK_WAIT=30s
# 最多尝试几次，用完写入 consumer_dead_letters
CONSUMER_MAX_DELIVER=10
CONSUMER_BATCH_SIZE=10
CONSUMER_MAX_ACK_PENDING=1000
CONSUMER_HANDLER_TIMEOUT=20s
# 去重记录保留多久，必须长于 NATS_STREAM_MAX_AGE（启动时会校验）
CONSUMER_DEDUP_RETENTION=336h
