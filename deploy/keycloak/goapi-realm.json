{
  "realm": "goapi",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      {
        "name": "goapi-viewer",
        "description": "goapi 只读"
      },
      {
        "name": "goapi-admin",
        "description": "goapi 读写"
      }
    ]
  },
  "clients": [
    {
      "clientId": "goapi-cli",
      "name": "goapi 本地测试客户端",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "goapi-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "goapi",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@goapi.local",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ],
      "realmRoles": [
        "goapi-admin"
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@goapi.local",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Viewer",
      "credentials": [
        {
          "type": "password",
          "value": "bob",
          "temporary": false
        }
      ],
      "realmRoles": [
        "goapi-viewer"
      ]
    },
    {
      "username": "carol",
      "enabled": true,
      "email": "carol@goapi.local",
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Nobody",
      "credentials": [
        {
          "type": "password",
          "value": "carol",
          "temporary": false
        }
      ],
      "realmRoles": []
    }
  ]
}
