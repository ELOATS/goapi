DATABASE_URL=postgres://app:app@localhost:15432/app?sslmode=disable
DB_MAX_CONNS=10
DB_MIGRATE_ON_START=true
# 设置后开启链路追踪
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=goapi
TRACE_SAMPLE_RATIO=1.0
METRICS_ADDR=:9090
PPROF_ENABLED=false
# 告警通知（docker compose 会自动读取项目根目录的 .env）
# 飞书群 → 设置 → 群机器人 → 自定义机器人；开启「签名校验」后填 FEISHU_SECRET
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=
# 钉钉群 → 群设置 → 机器人 → 自定义；安全设置选「加签」后填 DINGTALK_SECRET
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=

# 本地 compose 映射到宿主机的端口（docker compose 会读这个文件）。默认值避开了常用端口，冲突时再改
# GOAPI_DB_PORT=15432
# GOAPI_REDIS_PORT=16379
# GOAPI_NATS_PORT=14222
# GOAPI_NATS_MONITOR_PORT=18222
